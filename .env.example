ENVIRONMENT=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://loan_agent:loan_agent@localhost:5432/loan_agent
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MOCK=false

DATA_DIR=./data
MAX_ATTACHMENT_BYTES=10485760

OCR_ENABLED=true
OCR_DPI=200
OCR_LANGUAGE=eng
TESSERACT_CMD=

REDIS_URL=redis://localhost:6379/0
IDEMPOTENCY_TTL_SECONDS=86400

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Security — inject via environment, never commit real values
OPENAI_API_KEY=
CORE_BANKING_URL=
WEBHOOK_SIGNING_SECRET=
REQUIRE_WEBHOOK_SIGNATURE=false
LOG_SECRETS_REDACTION=true

